GROQ_API_KEY=your_groq_key_here
CHIMEGE_TOKEN=your_chimege_token_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# MongoDB is optional. If it is unreachable the server keeps working and saves
# to backend/data/ instead, then copies that data into MongoDB once it reconnects.
# Set MONGO_URI=off to run with local storage only.
MONGO_URI=mongodb://127.0.0.1:27017/mine_safety